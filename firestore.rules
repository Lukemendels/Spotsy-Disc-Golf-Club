rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isClubAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'club_admin' ||
         request.auth.token.email == 'lukemendelsohn@gmail.com');
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Officers
    match /officers/{officerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Casual Rounds
    match /rounds/{roundId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isClubAdmin();
    }

    // Beginner Signups
    match /beginnerSignups/{signupId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

    // Newsletter / Announcement Subscriptions
    match /announcementSubscriptions/{subId} {
      allow read: if isSignedIn();
      allow create: if true;
    }
  }
}
